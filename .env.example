NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Production project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional dedicated Demo Supabase project (if omitted, demo routes fall back to isolated in-memory/cookie-scoped demo mode or environment='demo' tenant)
NEXT_PUBLIC_DEMO_SUPABASE_URL=
NEXT_PUBLIC_DEMO_SUPABASE_ANON_KEY=
DEMO_SUPABASE_SERVICE_ROLE_KEY=

# Server-side AI (never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional source ingestion cron protection
INGESTION_CRON_SECRET=
